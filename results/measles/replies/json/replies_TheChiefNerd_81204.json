iates_highlighted_label': {}, 'has_graduated_access': True, 'is_blue_verified': True, 'profile_image_shape': 'Circle', 'legacy': {'can_dm': True, 'can_media_tag': True, 'created_at': 'Mon May 11 21:43:37 +0000 2009', 'default_profile': False, 'default_profile_image': False, 'description': 'NJ Assemblywoman LD24 ~ \nPublic Charter School Administrator', 'entities': {'description': {'urls': []}}, 'fast_followers_count': 0, 'favourites_count': 21506, 'followers_count': 5001, 'friends_count': 993, 'has_custom_timelines': False, 'is_translator': False, 'listed_count': 17, 'location': 'Franklin, NJ', 'media_count': 605, 'name': 'Dawn Fantasia', 'normal_followers_count': 5001, 'pinned_tweet_ids_str': [], 'possibly_sensitive': False, 'profile_banner_url': 'https://pbs.twimg.com/profile_banners/39350148/1710013433', 'profile_image_url_https': 'https://pbs.twimg.com/profile_images/1802907924152434688/sIFsiZ7a_normal.jpg', 'profile_interstitial_type': '', 'screen_name': 'DawnFantasia_NJ', 'statuses_count': 2575, 'translator_type': 'none', 'verified': False, 'want_retweets': False, 'withheld_in_countries': []}}}}, 'unmention_data': {}, 'edit_control': {'initial_tweet_id': '1876254173966024804', 'edit_control_initial': {'edit_tweet_ids': ['1876254173966024804', '1876255184956871152'], 'editable_until_msecs': '1736172428000', 'is_edit_eligible': True, 'edits_remaining': '4'}}, 'previous_counts': {'bookmark_count': 0, 'favorite_count': 1, 'quote_count': 0, 'reply_count': 1, 'retweet_count': 1}, 'is_translatable': False, 'views': {'count': '8618', 'state': 'EnabledWithCount'}, 'source': '<a href="http://twitter.com/download/android" rel="nofollow">Twitter for Android</a>', 'note_tweet': {'is_expandable': True, 'note_tweet_results': {'result': {'id': 'Tm90ZVR3ZWV0OjE4NzYyNTUxODQ3MDk0MTkwMDg=', 'text': 'The Praxis tests ARE NOT eliminated in New Jersey. Praxis is a large collection of content area tests. Eliminating the basic skills test requirement DOES NOT eliminate all Praxis tests—this is just a small fraction of Praxis.\n\nFor example, to teach grades K-6, teachers still have to pass the tests in the image. That requirement has never changed. They are no longer required to take and pass an additional basic skills test, which is arguably much easier than the ones pictured.\n\nPrior to 2015 (the year the additional "basic skills" Praxis test was implemented), in order to earn my NJ teaching certification, I had to take and pass the K-6 Praxis tests in English, math, social studies, science, and a second ancillary test in English to be considered "highly qualified" to teach English in middle school grades 6-8.\n\nI passed every test, and on the English ancillary, I scored 195 out of 200, with a perfect 12 out of 12 in writing. Had this been 2015, I would have been required to take yet another set of tests—this time for "basic skills"—at $90 per test, payable directly to Educational Testing Services.\n\nSomeone is making money here. All of the prior tests are still in place. I agree with eliminating the additional basic skills tests, and not for any woke or DEI reasoning. This is simply a bureaucratic cash cow. The extra tests are a money-maker, as the original tests are sufficient to prove content knowledge.\n\nBefore any credential is issued to a prospective teacher (Certificate of Eligibility (CE) or Certificate of Eligibility with Advanced Standing (CEAS)), the candidate must pass the Praxis test(s) required for the subject area(s) they seek to teach. Once hired by a district, they receive a provisional certificate valid for two years. During this time, they must be formally evaluated a minimum of six times and receive an "effective" rating, be mentored, and—if they hold a CE—complete and pass educator coursework.\n\nA CEAS indicates the candidate completed their content area education and teacher preparation in college, including student teaching, so they are not required to complete the additional educator coursework required for those who did not go to school to become a teacher.\n\nWhat concerns me far more than eliminating redundant tests is the NJEA\'s push to change teacher evaluations. This is where teacher standards will be lowered, shifting the focus away from academic outcomes for students. I have spoken about this in session and committee and see it coming clearly. This is the real issue. Mark my words.', 'entity_set': {'hashtags': [], 'symbols': [], 'timestamps': [], 'urls': [], 'user_mentions': []}, 'richtext': {'richtext_tags': []}}}}, 'legacy': {'bookmark_count': 13, 'bookmarked': False, 'created_at': 'Mon Jan 06 13:11:09 +0000 2025', 'conversation_id_str': '1876255184956871152', 'display_text_range': [0, 280], 'entities': {'hashtags': [], 'media': [{'display_url': 'pic.x.com/h5awG3mV7G', 'expanded_url': 'https://x.com/DawnFantasia_NJ/status/1876255184956871152/photo/1', 'id_str': '1876254165720010752', 'indices': [281, 304], 'media_key': '3_1876254165720010752', 'media_url_https': 'https://pbs.twimg.com/media/GgnLORAWkAAQZqm.jpg', 'type': 'photo', 'url': 'https://t.co/h5awG3mV7G', 'ext_media_availability': {'status': 'Available'}, 'features': {'all': {'tags': [{'user_id': '1564797517241487361', 'name': 'Wake Up NJ 🇺🇸 New Jersey', 'screen_name': 'wakeupnj', 'type': 'user'}, {'user_id': '52077282', 'name': 'NJ Assembly GOP', 'screen_name': 'NJAssemblyGOP', 'type': 'user'}, {'user_id': '16911432', 'name': 'Save Jersey', 'screen_name': 'SaveJersey', 'type': 'user'}, {'user_id': '792177705831858176', 'name': 'Mike Crispi', 'screen_name': 'MikeCrispi', 'type': 'user'}, {'user_id': '19034576', 'name': 'Rich Zeoli 🇺🇸', 'screen_name': 'Richzeoli', 'type': 'user'}, {'user_id': '1148944618991554560', 'name': 'New Jersey Globe', 'screen_name': 'TheNJGlobe', 'type': 'user'}, {'user_id': '274523970', 'name': 'Matt Rooney', 'screen_name': 'MattRooneyNJ', 'type': 'user'}, {'user_id': '1561723814391808000', 'name': 'New Jersey Project', 'screen_name': 'fight4newjersey', 'type': 'user'}, {'user_id': '