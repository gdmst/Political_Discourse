dit_eligible': False, 'edits_remaining': '5'}, 'is_translatable': False, 'views': {'count': '20', 'state': 'EnabledWithCount'}, 'source': '<a href="http://twitter.com/download/iphone" rel="nofollow">Twitter for iPhone</a>', 'note_tweet': {'is_expandable': True, 'note_tweet_results': {'result': {'id': 'Tm90ZVR3ZWV0OjE4ODQ0MDYyNjA5ODE3NzYzODQ=', 'text': 'This article is a blatant attempt to fuel division and deflect blame. Let’s be clear: the FOIA records came from the federal government, the very institution that ran residential schools, and now oversees the funding they claim is “mismanaged.” Convenient, isn’t it? They hold the purse strings, impose red tape, and spend millions on bureaucratic consultants while Indigenous communities are left fighting for scraps and blamed when things aren’t perfect.\n\nThe government controls this entire process. Every dollar must go through their approval, every project delayed by their inefficiency. They’re the ones funneling millions to consultants, marketing, and admin—NOT the communities who are still living with the trauma of this genocide. And yet, articles like this want you to believe it’s Indigenous people mismanaging funds? That’s some cowardly colonial gaslighting.\n\nThe real story is the government’s refusal to take real accountability for the harm it caused and the systems it still controls. And the media? They’re complicit, painting a twisted narrative to make people look the other way. The truth is simple: blame lies with the colonial institutions, not the survivors trying to heal from the wounds they inflicted.', 'entity_set': {'hashtags': [], 'symbols': [], 'urls': [], 'user_mentions': []}}}}, 'legacy': {'bookmark_count': 0, 'bookmarked': False, 'created_at': 'Wed Jan 29 01:00:37 +0000 2025', 'conversation_id_str': '1884036198013837661', 'display_text_range': [15, 295], 'entities': {'hashtags': [], 'symbols': [], 'timestamps': [], 'urls': [], 'user_mentions': [{'id_str': '24700876', 'name': 'Toronto Sun', 'screen