ull Article↘️↘️\n\n🔍"Mid-2020 GITMO Update: Arrests, Indictments, & Executions"\n💊 https://t.co/8qjkOe3N3f\n💊 https://t.co/4wLRRt5qA2', 'entity_set': {'hashtags': [], 'symbols': [], 'urls': [{'display_url': 'humorousmathematics.com/post/mid-2020-…', 'expanded_url': 'https://www.humorousmathematics.com/post/mid-2020-gitmo-update-arrests-indictments-executions', 'url': 'https://t.co/8qjkOe3N3f', 'indices': [1225, 1248]}, {'display_url': 'giveit.link/OperationQ', 'expanded_url': 'https://giveit.link/OperationQ', 'url': 'https://t.co/4wLRRt5qA2', 'indices': [1251, 1274]}], 'user_mentions': [{'id_str': '10126672', 'name': 'U.S. Marines', 'screen_name': 'USMC', 'indices': [925, 930]}, {'id_str': '54885400', 'name': 'U.S. Navy', 'screen_name': 'USNavy', 'indices': [931, 938]}, {'id_str': '19611483', 'name': 'U.S. Air Force', 'screen_name': 'USAirForce', 'indices': [939, 950]}, {'id_str': '8775672', 'name': 'U.S. Army', 'screen_name': 'USArmy', 'indices': [951, 958]}, {'id_str': '26572460', 'name': 'United States Space Force', 'screen_name': 'SpaceForceDoD', 'indices': [965, 979]}, {'id_str': '66369181', 'name': 'Department of Defense 🇺🇸', 'screen_name': 'DeptofDefense', 'indices': [980, 994]}, {'id_str': '16133530', 'name': 'Ministry of Defence 🇬🇧', 'screen_name': 'DefenceHQ', 'indices': [1011, 1021]}, {'id_str': '3834915802', 'name': 'Armada Argentina', 'screen_name': 'Armada_Arg', 'indices': [1022, 1033]}, {'id_str': '25073877', 'name': 'Donald J. Trump', 'screen_name': 'realDonaldTrump', 'indices': [1059, 1075]}, {'id_str': '4020276615', 'name': 'Javier Milei', 'screen_name': 'JMilei', 'indices': [1113, 1120]}]}, 'richtext': {'richtext_tags': [{'from_index': 3, 'to_index': 32, 'richtext_types': ['Bold']}, {'from_index': 40, 'to_index': 64, 'richtext_types': ['Bold']}]}, 'media': {'inline_media': []}}}}, 'legacy': {'bookmark_count': 932, 'bookmarked': False, 'created_at': 'Fri Aug 23 04:41:13 +0000 2024', 'conversation_id_str': '1630458471123501057', 'display_text_range'