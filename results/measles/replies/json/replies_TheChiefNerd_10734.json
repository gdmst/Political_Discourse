is_edit_eligible': False, 'edits_remaining': '5'}, 'is_translatable': False, 'views': {'count': '699', 'state': 'EnabledWithCount'}, 'source': '<a href="http://twitter.com/download/iphone" rel="nofollow">Twitter for iPhone</a>', 'note_tweet': {'is_expandable': True, 'note_tweet_results': {'result': {'id': 'Tm90ZVR3ZWV0OjE4ODQ5MDk4MTcxNzkwMjk1MDQ=', 'text': 'And just yesterday, I just had written my response to @Teawisher about how we work towards producing rich soil onsite → https://t.co/0TbflzUbR4\n\nFurthermore, when we reach even larger capacity (such as with cattle in rotational grazing) then we’ll produce even richer soil!\n\nHere’s part of how Joel Salatin does it, including with the use of a wood chipper, pigs, rabbits, cattle, chickens, and tying all of these systems together to build a vibrant ecosystem:', 'entity_set': {'hashtags': [], 'symbols': [], 'urls': [{'display_url': 'x.com/ltgiv/status/1…', 'expanded_url': 'https://x.com/ltgiv/status/1884536388952916270', 'url': 'https://t.co/0TbflzUbR4', 'indices': [120, 143]}], 'user_mentions': [{'id_str': '962368138871476224', 'name': 'Sampo Lähteenaro (Science and tech Greens 🇫🇮🌲)', 'screen_name': 'Teawisher', 'indices': [54, 64]}]}}}}, 'quoted_status_result': {'result': {'__typename': 'Tweet', 'rest_id': '1884536388952916270', 'core': {'user_results': {'result': {'__typename': 'User', 'id': 'VXNlcjozMDYwNTkxNTE=', 'rest_id': '306059151', 'affiliates_highlighted_label': {}, 'has_graduated_access': True, 'is_blue_verified': True, 'profile_image_shape': 'Circle', 'legacy': {'can_dm': False, 'can_media_tag': False, 'created_at': 'Fri May 27 06:28:58 +0000 2011', 'default_profile': True, 'default_profile_image': False, 'description': 'e/acc: Farmer-Scientist engineering Post-Scarcity at @wwwLiveFarm for self-sustaining homesteads with Permaculture, Robotics, & AI; driven by micro-factories.', 'entities': {'description': {'urls': []}, 'url': {'urls': [{'display_url': 'LTG.FYI', 'expanded_url': 'https://WWW.LTG.FYI', 'url': 'https://t.co/JFkDmpTkBq', 'indices': [0, 23]}]}}, 'fast_followers_count': 0, 'favourites_count': 369210, 'followers_count': 3907, 'friends_count': 3095, 'has_custom_timelines': True, 'is_translator': False, 'listed_count': 212, 'location': 'Texas – Asia – Middle East', 'media_count': 17113, 'name': 'Louis T. Getterman IV — e/acc', 'normal_followers_count': 3907, 'pinned_tweet_ids_str': ['1643357935433838592'], 'possibly_sensitive': False, 'profile_banner_url': 'https://pbs.twimg.com/profile_banners/306059151/1676410831', 'profile_image_url_https': 'https://pbs.twimg.com/profile_images/1625610962043543563/s9m_AU-F_normal.jpg', 'profile_interstitial_type': '', 'screen_name': 'ltgiv', 'statuses_count': 54936, 'translator_type': 'none', 'url': 'https://t.co/JFkDmpTkBq', 'verified': False, 'want_retweets': False, 'withheld_in_countries': []}, 'professional': {'rest_id': '1598477764813799424', 'professional_type': 'Creator', 'category': [{'id': 713, 'name': 'Science & Technology', 'icon_name': 'IconBriefcaseStroke'}]}}}}, 'unmention_data': {}, 'edit_control': {'edit_tweet_ids': ['1884536388952916270'], 'editable_until_msecs': '1738147062000', 'is_edit_eligible': True, 'edits_remaining': '5'}, 'is_translatable': False, 'views': {'count': '856', 'state': 'EnabledWithCount'}, 'source': '<a href="http://twitter.com/download/iphone" rel="nofollow">Twitter for iPhone</a>', 'note_tweet': {'is_expandable': True, 'note_tweet_results': {'result': {'id': 'Tm90ZVR3ZWV0OjE4ODQ1MzYzODg3NzI2MTgyNDA=', 'text': 'Any time scorpions become too much, I flood the entire area around my house with chickens — as long as I don’t lose too many to varmints such as hawks.\n\nThe chicken (and when we’re ready, fish) equivalent of catnip that they go nuts for is Black Soldier Fly Larvae (my build guide is at https://t.co/zE1Jw0TCp7) which breakdown almost all of our organic waste stream during their season (April – November.)\n\nYou can further tie these systems together by using Red Wiggler Worms to break down the frass (feces) from the Black Soldier Fly Larvae. When you keep tying these systems together then you’ll find that you’re even producing your own VERY RICH soil onsite.\n\nI’m still smiling ear-to-ear from a call that I had a week ago with one of America’s largest agricultural firms where they said that https://t.co/kG2BbnS4ai is “radically self-sufficient”. That’s not the way that I’d describe it, but, I’ll take it! 🤗\n\nSome of the upcoming work in the pipeline is where we are FINALLY getting to some of the cooler work that I’ve been trying to get us to for years.', 'entity_set': {'hashtags': [], 'symbols': [], 'urls': [{'display_url': 'LTG.FYI/LOTF', 'expanded_url': 'http://LTG.FYI/LOTF', 'url': 'https://t.co/zE1Jw0TCp7', 'indices': [287, 310]}, {'display_url': 'Live.Farm', 'expanded_url': 'http://Live.Farm', 'url': 'https://t.co/kG2BbnS4ai', 'indices': [798, 821]}], 'user_mentions': []}}}}, 'quotedRefResult': {'result': {'__typename': 'Tweet', 'rest_id': '1884471596309487875'}}, 'legacy': {'bookmark_count': 0, 'bookmarked': False, 'created_at': 'Wed Jan 29 09:37:42 +0000 2025', 'conversation_id_str': '1884536388952916270', 'display_text_range': [0, 280], 'entities': {'hashtags': [], 'media': [{'display_url': 'pic.x.com/LRESqO9acS', 'expanded_url': 'https://x.com/ltgiv/status/1884536388952916270/video/1', 'id_str': '1884536195138437120', 'indices': [281, 304], 'media_key': '13_1884536195138437120', 'media_url_https': 'https://pbs.twimg.com/amplify_video_thumb/1884536195138437120/img/mokXlvDZGZG5oDet.jpg', 'type': 'video', 'url': 'https://t.co/LRESqO9acS', 'additional_media_info': {'monetizable': False}, 'ext_media_availability': {'status': 'Available'}, 'sizes': {'large': {'h': 1080, 'w': 1920, 'resize': 'fit'}, 'medium': {'h': 675, 'w': 1200, 'resize': 'fit'}, 'small': {'h': 383, 'w': 680, 'resize': 'fit'}, 'thumb': {'h': 150, 'w': 150, 'resize': 'crop'}}, 'original_info': {'height': 1080, 'width': 1920, 'focus_rects': []}, 'allow_downloa