{'_client': <twikit.client.client.Client object at 0x000001E534E2AE40>, '_data': {'__typename': 'Tweet', 'rest_id': '1883526475787186246', 'core': {'user_results': {'result': {'__typename': 'User', 'id': 'VXNlcjoxNzIwMzY1NjE3MjYwMTc5NDU3', 'rest_id': '1720365617260179457', 'affiliates_highlighted_label': {}, 'has_graduated_access': True, 'is_blue_verified': True, 'profile_image_shape': 'Circle', 'legacy': {'can_dm': False, 'can_media_tag': True, 'created_at': 'Fri Nov 03 09:01:57 +0000 2023', 'default_profile': True, 'default_profile_image': False, 'description': 'Rav Ram ben Ze’ev | Jewish 🇬🇧 🇺🇸 | Exec Dir @hebrewsynagogue | Dir @maysidepartners | Once voted ‘Most Likely to Rule on Everything’ at Yeshiva', 'entities': {'description': {'urls': []}, 'url': {'urls': [{'display_url': 'rambenzeev.com', 'expanded_url': 'https://rambenzeev.com', 'url': 'https://t.co/evcKzv3gKD', 'indices': [0, 23]}]}}, 'fast_followers_count': 0, 'favourites_count': 12834, 'followers_count': 5187, 'friends_count': 201, 'has_custom_timelines': False, 'is_translator': False, 'listed_count': 21, 'location': 'Israel, Scotland', 'media_count': 332, 'name': "Ram ben Ze'ev", 'normal_followers_count': 5187, 'pinned_tweet_ids_str': ['1741263887670898897'], 'possibly_sensitive': False, 'profile_banner_url': 'https://pbs.twimg.com/profile_banners/1720365617260179457/1699797699', 'profile_image_url_https': 'https://pbs.twimg.com/profile_images/1909394136316149760/yyN28enr_normal.jpg', 'profile_interstitial_type': '', 'screen_name': 'rambenzeev', 'statuses_count': 11782, 'translator_type': 'none', 'url': 'https://t.co/evcKzv3gKD', 'verified': False, 'want_retweets': False, 'withheld_in_countries': []}, 'professional': {'rest_id': '1932215339443486848', 'professional_type': 'Creator', 'category': [{'id': 960, 'name': 'Spiritual Leader', 'icon_name': 'IconBriefcaseStroke'}]}}}}, 'unmention_data': {}, 'edit_control': {'edit_tweet_ids': ['1883526475787186246'], 'editable_until_msecs': '1737906280000', 'is_edit_eligible': False, 'edits_remaining': '5'}, 'is_translatable': False, 'views': {'count': '288', 'state': 'EnabledWithCount'}, 'source': '<a href="http://twitter.com/download/iphone" rel="nofollow">Twitter for iPhone</a>', 'note_tweet': {'is_expandable': True, 'note_tweet_results': {'result': {'id': 'Tm90ZVR3ZWV0OjE4ODM1MjY0NzU2MzE5NjAwNjQ=', 'text': 'People today need to stop focusing solely on themselves and start thinking about and doing more for others. This pervasive culture of self-centredness has led to a society where the word “I” is overused, and the needs of others are overlooked. The Torah teaches us the profound value of חסד (chesed)—acts of loving-kindness—as the foundation of a just and compassionate world.\n\nReflect for a moment on how many times you use the word “I” in a day. Each instance might represent a missed opportunity to focus on someone else’s needs, struggles, or wellbeing. Instead of centring ourselves, we should strive to follow the Torah’s directive to “love your fellow as yourself” (ואהבת לרעך כמוך, Vayikra 19:18), which calls us to shift our perspective outward, toward the collective good.\n\nHumility is a key value in Judaism, exemplified by Moshe Rabbeinu (Moses), who was described as “the most humble of all men.” His humility allowed him to lead selflessly, focusing on the needs of others rather than his own. Similarly, the structure of Jewish communal prayer uses plural language—“we” and “our”—to remind us that we stand before G-D not as individuals, but as a collective, responsible for one another.\n\nReducing the emphasis on “I” is not about denying personal needs but about recognising that true fulfilment comes from giving. By shifting our focus outward, we not only elevate ourselves spiritually but also contribute to תיקון עולם (Tikkun Olam), the repair of the world. Let us challenge ourselves to lessen the “I” in our daily vocabulary and replace it with actions that uplift those around us. This small change in mindset could have a profound impact on our lives and the world as a whole.\n\nRAM', 'entity_set': {'hashtags': [], 'symbols': [], 'urls': [], 'user_mentions': []}}}}, 'legacy': {'bookmark_count': 0, 'bookmarked': False, 'created_at': 'Sun Jan 26 14:44:40 +0000 2025', 'conversation_id_str': '1883513599282630734', 'display_text_range': [14, 291], 'entities': {'hashtags': [], 'symbols': [], 'timestamps': [], 'urls': [], 'user_mentions': [{'id_str': '69156861', 'name': 'Chief Nerd', 'screen_name': 'TheChiefNerd', 'indices': [0, 13]}]}, 'favorite_count': 7, 'favorited': False, 'full_text': '@TheChiefNerd People today need to stop focusing solely on themselves and start thinking about and doing more for others. This pervasive culture of self-centredness has led to a society where the word “I” is overused, and the needs of others are overlooked. The Torah teaches us the profound', 'in_reply_to_screen_name': 'TheChiefNerd', 'in_reply_to_status_id_str': '1883513599282630734', 'in_reply_to_user_id_str': '69156861', 'is_quote_status': False, 'lang': 'en', 'quote_count': 0, 'reply_count': 0, 'retweet_count': 4, 'retweeted': False, 'user_id_str': '1720365617260179457', 'id_str': '1883526475787186246'}}, '_legacy': {'bookmark_count': 0, 'bookmarked': False, 'created_at': 'Sun Jan 26 14:44:40 +0000 2025', 'conversation_id_str': '1883513599282630734', 'display_text_range': [14, 291], 'entities': {'hashtags': [], 'symbols': [], 'timestamps': [], 'urls': [], 'user_mentions': [{'id_str': '69156861', 'name': 'Chief Nerd', 'screen_name': 'TheChiefNerd', 'indices': [0, 13]}]}, 'favorite_count': 7, 'favorited': False, 'full_text': '@TheChiefNerd People today need to stop focusing solely on themselves and start thinking about and doing more for others. This pervasive culture of self-centredness has led to a society where the word “I” is overused, and the needs of others are overlooked. The Torah teaches us the profound', 'in_reply_to_screen_name': 'TheChiefNerd', 'in_reply_to_status_id_str': '1883513