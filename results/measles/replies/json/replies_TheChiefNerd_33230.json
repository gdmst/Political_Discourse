 Fox 🦊', 'screen_name': 'VigilantFox', 'indices': [959, 971]}, {'id_str': '14515734', 'name': 'Dr. Drew', 'screen_name': 'drdrew', 'indices': [972, 979]}, {'id_str': '18584875', 'name': 'Hodgetwins', 'screen_name': 'hodgetwins', 'indices': [980, 991]}]}}}}, 'legacy': {'bookmark_count': 3199, 'bookmarked': False, 'created_at': 'Wed Jan 22 22:20:11 +0000 2025', 'conversation_id_str': '1882191557237027101', 'display_text_range': [0, 277], 'entities': {'hashtags': [], 'media': [{'display_url': 'pic.x.com/17ABCHYeaW', 'expanded_url': 'https://x.com/RenzTom/status/1882191557237027101/photo/1', 'id_str': '1882191543895007232', 'indices': [278, 301], 'media_key': '3_1882191543895007232', 'media_url_https': 'https://pbs.twimg.com/media/Gh7jPKUbIAAUGfg.jpg', 'type': 'photo', 'url': 'https://t.co/17ABCHYeaW', 'ext_media_availability': {'status': 'Available'}, 'features': {'large': {'faces': []}, 'medium': {'faces': []}, 'small': {'faces': []}, 'orig': {'faces': []}}, 'sizes': {'large': {'h': 602, 'w': 451, 'resize': 'fit'}, 'medium': {'h': 602, 'w': 451, 'resize': 'fit'}, 'small': {'h': 602, 'w': 451, 'resize': 'fit'}, 'thumb': {'h': 150, 'w': 150, 'resize': 'crop'}}, 'original_info': {'height': 602, 'width': 451, 'focus_rects': [{'x': 0, 'y': 9, 'w': 451, 'h': 253}, {'x': 0, 'y': 0, 'w': 451, 'h': 451}, {'x': 0, 'y': 0, 'w': 451, 'h': 514}, {'x': 75, 'y': 0, 'w': 301, 'h': 602}, {'x': 0, 'y': 0, 'w': 451, 'h': 602}]}, 'allow_download_status': {'allow_download': True}, 'media_results': {'result': {'media_key': '3_1882191543895007232'}}}, {'display_url': 'pic.x.com/17ABCHYeaW', 'expanded_url': 'https://x.com/RenzTom/status/1882191557237027101/photo/1', 'id_str': '1882191543861411840', 'indices': [278, 301], 'media_key': '3_1882191543861411840', 'media_url_https': 'https://pbs.twimg.com/media/Gh7jPKMagAAKO36.jpg', 'type': 'photo', 'url': 'https://t.co/17ABCHYeaW', 'ext_media_availability': {'status': 'Available'}, 'features': {'large': {'faces': []}, 'medium': {'faces': []}, 'sm